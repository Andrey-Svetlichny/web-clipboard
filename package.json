{
  "name": "web-clipboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted clipboard relay",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "node --env-file=dev.env --watch-path=server --watch-path=web server/index.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "vectors": "node tests/make-vectors.mjs",
    "smoke": "node tests/smoke.mjs"
  }
}
