{
  "name": "web-clipboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "End-to-end encrypted clipboard relay",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "CLIPBOARD_DB=./dev.db HOST=127.0.0.1 node --watch --watch-path=web --watch-path=server --disable-warning=ExperimentalWarning server/index.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "vectors": "node tests/make_vectors.mjs",
    "smoke": "node tests/smoke.mjs"
  }
}
